# ─────────────────────────────────────────────────────────────────────────────
# Vision Studio — configuration
#
# Every value below has a working default. The application runs with no .env
# file at all: there are no external service credentials, no OAuth, no hosted
# database. Copy to `.env.local` only to override.
# ─────────────────────────────────────────────────────────────────────────────

# ── Storage ──────────────────────────────────────────────────────────────────
# Root for the SQLite database and all media. Relative paths resolve from the
# project root.
VISION_STUDIO_DATA_DIR=./data

# Directory holding ONNX model weights (populated by `npm run models:fetch`).
VISION_STUDIO_MODEL_DIR=./models

# ── Vision engine ────────────────────────────────────────────────────────────
# Longest edge (px) the engine downsamples to before inference. Landmarks are
# always mapped back to full source-image coordinates, so this trades inference
# cost for detection accuracy on small faces, not output precision.
VISION_ANALYSIS_MAX_DIM=1280

# Detection thresholds. Deterministic — the same image always yields the same
# result for a given set of thresholds and model versions.
VISION_PERSON_SCORE_THRESHOLD=0.35
VISION_PERSON_NMS_IOU=0.45
VISION_FACE_SCORE_THRESHOLD=0.50
VISION_FACE_NMS_IOU=0.40
VISION_KEYPOINT_SCORE_THRESHOLD=0.30
VISION_MASK_BINARY_THRESHOLD=0.50

# ONNX Runtime intra-op threads per worker. Left to ORT this is one thread per
# core per session, which oversubscribes badly across several workers. Blank
# defaults to 1.
VISION_ORT_THREADS=

# ── Job execution ────────────────────────────────────────────────────────────
# Worker processes for vision analysis. Each holds ~700 MB (model weights plus
# activations) and its own ONNX Runtime session. Defaults to 1 — deliberately,
# not sized off cores or memory. This runs on a laptop alongside a browser, an
# IDE and everything else already open, not a dedicated server, and more than
# one of these loading models at the same moment is what turns "generation is
# slow" into "the whole machine stops responding to anything." Raise this only
# on a machine you have confirmed has real headroom to spare.
JOB_VISION_CONCURRENCY=
# Worker processes for creative rendering. Lighter than a vision worker (no
# ONNX session, just a canvas and a decoded image), but defaults to 1 for the
# same reason.
JOB_RENDER_CONCURRENCY=
# Poll interval (ms) for the SQLite-backed queue.
JOB_POLL_INTERVAL_MS=250
# Attempts per job before it is parked as `failed` and awaits manual retry.
JOB_MAX_ATTEMPTS=3
# A job claimed but not heartbeated for this long is presumed abandoned and
# reclaimed — also the lease DURATION granted at claim time.
JOB_STALE_CLAIM_MS=300000
# A 'bulk' job (an import's vision analysis, a batch over 20 images) pending
# longer than this is promoted to 'interactive' class so a steady stream of
# fresh bulk work from other tenants can never starve it indefinitely.
BULK_MAX_WAIT_SECONDS=900
# Finished (completed/failed/cancelled) job rows older than this many days
# are deleted from control.db. Each batch's own summary counts are already
# persisted onto its `batches` row well before this elapses, so nothing a
# caller still needs is lost.
JOB_RETENTION_DAYS=30
# How often the SLOW maintenance sweep runs: job retention pruning, plus the
# per-tenant media orphan sweep and storage-usage reconciliation (each a
# real disk walk, unlike the 60s fast sweep's cheap indexed SQL).
JOB_MAINTENANCE_SWEEP_INTERVAL_MS=1800000
# A tmp/ upload fragment older than this is presumed abandoned (crashed or
# killed request, client disconnect) and removed by the same sweep.
UPLOAD_TMP_TTL_MS=21600000
# On SIGTERM: stop claiming new jobs immediately, give in-flight ones this
# long to finish, then kill whatever's left and hand its job back to pending
# with NO attempt consumed. The orchestrator's own stop timeout (Docker's
# `docker stop -t`, Kubernetes' terminationGracePeriodSeconds) MUST be set
# longer than this, or SIGKILL arrives first and skips the graceful path —
# see docs/OPERATIONS.md.
SHUTDOWN_GRACE_SECONDS=30
# New uploads are refused with a clear error below this much free space on
# the data volume. Checked before accepting any bytes.
DISK_MIN_FREE_GB=2
# Per-kind watchdog (ms): a job whose 'running' status outlives this is
# presumed hung, not merely slow — the pool kills and respawns the worker
# holding it and counts a failed attempt. Leave blank for the built-in
# defaults (60s vision, 90s render, CLOUDINARY_TIMEOUT_MS+60s background_fill).
JOB_MAX_RUNTIME_VISION_MS=
JOB_MAX_RUNTIME_RENDER_MS=
JOB_MAX_RUNTIME_BACKGROUND_FILL_MS=

# ── AI Extend dispatcher ─────────────────────────────────────────────────────
# Circuit breaker for the WHOLE shared Cloudinary account (independent of any
# one tenant's own quota) — protects against runaway spend across every
# tenant combined. A warning logs at 80% of this; the dispatcher refuses
# outright at 100%.
AI_EXTEND_GLOBAL_MONTHLY_CAP=20000
# Max simultaneous Cloudinary calls across every background_fill worker
# process. Defaults to CLOUDINARY_JOB_CONCURRENCY (the worker slot count),
# since that already bounds this structurally in the common case.
AI_EXTEND_GLOBAL_CONCURRENCY=
# Token-bucket rate limit: refilled at this rate, capped at this burst size.
AI_EXTEND_RATE_LIMIT_PER_SECOND=2
AI_EXTEND_RATE_LIMIT_BURST=4
# Per-tenant concurrent Cloudinary calls — independent of the global cap.
AI_EXTEND_PER_TENANT_CONCURRENCY=2
# Low on purpose: every retry can spend a paid generative credit.
AI_EXTEND_MAX_ATTEMPTS=3
AI_EXTEND_BASE_BACKOFF_MS=2000
AI_EXTEND_MAX_BACKOFF_MS=30000

# ── Observability ────────────────────────────────────────────────────────────
# How often the event-loop delay monitor logs mean/p50/p99/max and resets its
# window (see src/lib/event-loop-monitor.ts). Log-only — no endpoint yet.
EVENT_LOOP_LOG_INTERVAL_MS=60000

# ── Rendering ────────────────────────────────────────────────────────────────
# Longest edge of a generated creative.
RENDER_OUTPUT_MAX_DIM=2048
# Supersample factor before downscale (1 = off, 2 = recommended).
RENDER_SUPERSAMPLE=2
RENDER_JPEG_QUALITY=95

# ── Export conversion concurrency (P4) ──────────────────────────────────────
# Caps on sharp decode/re-encode work for single-creative exports and ZIP
# downloads — both run in the WEB process, never a worker, so these bound the
# event loop directly rather than a background queue.
EXPORT_GLOBAL_CONCURRENCY=4
EXPORT_PER_TENANT_CONCURRENCY=2
# How long a request waits for a free slot before failing with 429/503 +
# Retry-After, rather than queueing indefinitely.
EXPORT_SLOT_WAIT_MS=2000
# A bulk ZIP's OWN internal cap on conversions in flight at once — layered on
# top of the two caps above, not a replacement for them.
ZIP_INTERNAL_CONCURRENCY=3

# ── AI Extend (Cloudinary generative fill) ──────────────────────────────────
# Only reached when a template's background mode is set to "AI Extend". The one
# outbound network dependency in this app, and the one that costs money: every
# generative fill spends paid Cloudinary credits, so results are cached as
# derived assets and an identical re-render never calls the API again.
#
# Left blank the feature is simply unavailable; everything else works offline.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Concurrent Cloudinary calls. Separate from JOB_RENDER_CONCURRENCY on purpose
# — this waits on a remote, rate-limited, billed API rather than local CPU, so
# it must not be sized off cores or take render slots.
CLOUDINARY_JOB_CONCURRENCY=4
# Request timeout (ms). A first-time derivation genuinely renders on their
# side and can take 30-60s; this bounds a stuck request, not a slow one.
CLOUDINARY_TIMEOUT_MS=180000
# Longest edge the generated background is produced at. Must be >= your
# template canvas's longest edge — the renderer composites the original photo
# back over this background, and a smaller background lands soft and slightly
# offset under it, showing a visible rectangle around the subject.
CLOUDINARY_MAX_UPLOAD_DIM=4096

# ── Authentication & tenancy ─────────────────────────────────────────────────
# No open sign-up — every account is created by an admin (currently via the
# legacy-migration script; a proper admin UI for creating further accounts is
# a later phase). Leave false unless you deliberately want self-service
# registration.
ALLOW_SIGNUP=false

# Bootstraps the first platform admin + tenant. Required to run
# `npm run tenants:migrate-legacy`; not read anywhere else.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sliding session expiry (ms) — refreshed on every authenticated request, so
# this is "how long since your LAST visit", not a fixed login duration.
SESSION_TTL_MS=2592000000

# Login attempts allowed per account and per IP within the window below
# before that identifier is rate-limited.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MS=900000

# Marks the session cookie `Secure`, which browsers then refuse to send over
# plain HTTP. Defaults to true when NODE_ENV=production, false otherwise —
# `npm run dev` over http://localhost needs false (its own default), a real
# deployment needs true (also its own default). Override explicitly only to
# test one mode's cookie behaviour from the other, or to deliberately run a
# production deployment with no TLS yet, understanding the session token
# then travels in cleartext — the actual fix there is terminating TLS at the
# reverse proxy (see docs/DEPLOY.md), not this flag.
COOKIE_SECURE=

# Trust `X-Forwarded-For` for login rate-limiting's client IP. Leave false
# unless the app sits behind a reverse proxy YOU control that overwrites
# this header rather than appending to it (Caddy's default `reverse_proxy`
# does) — otherwise a client can pick its own rate-limit bucket (or someone
# else's) just by setting the header itself.
TRUST_PROXY=false

# This app's own public origin, e.g. https://vision.example.com. Required
# in production: the mutating-request Origin check compares against this
# instead of Next.js's own (internal, proxy-hidden) view of its host.
# Leave blank in development — localhost needs no proxy in front, so
# Next.js's own host is already correct there.
APP_ORIGIN=

# Gates creating a second (or further) tenant. As of P3 the scheduler, job
# queue, and quotas are genuinely multi-tenant-safe (see
# docs/MULTI_TENANCY.md) — this is no longer an architectural necessity, but
# a deliberate opt-in kept until real production load-test evidence and
# operating history justify turning it on by default. Tenant creation
# refuses outright unless this is set to exactly "1". See docs/DEPLOY.md's
# "ALLOW_MULTI_TENANT_PREVIEW" section for the exact removal criteria and
# the current recommendation.
ALLOW_MULTI_TENANT_PREVIEW=

# ── Backup / restore (P6) ───────────────────────────────────────────────────
# Where `npm run backup` writes snapshots and `npm run restore` reads them
# from, when neither script's own --out/--backup-root flag is given.
# Never read anywhere else in the app — backup scripts only.
BACKUP_DIR=./backups
