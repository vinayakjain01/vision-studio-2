# ─────────────────────────────────────────────────────────────────────────────
# Vision Studio — configuration
#
# Every value below has a working default. The application runs with no .env
# file at all: there are no external service credentials, no OAuth, no hosted
# database. Copy to `.env.local` only to override.
# ─────────────────────────────────────────────────────────────────────────────

# ── Storage ──────────────────────────────────────────────────────────────────
# Root for the SQLite database and all media. Relative paths resolve from the
# project root.
VISION_STUDIO_DATA_DIR=./data

# Directory holding ONNX model weights (populated by `npm run models:fetch`).
VISION_STUDIO_MODEL_DIR=./models

# ── Vision engine ────────────────────────────────────────────────────────────
# Longest edge (px) the engine downsamples to before inference. Landmarks are
# always mapped back to full source-image coordinates, so this trades inference
# cost for detection accuracy on small faces, not output precision.
VISION_ANALYSIS_MAX_DIM=1280

# Detection thresholds. Deterministic — the same image always yields the same
# result for a given set of thresholds and model versions.
VISION_PERSON_SCORE_THRESHOLD=0.35
VISION_PERSON_NMS_IOU=0.45
VISION_FACE_SCORE_THRESHOLD=0.50
VISION_FACE_NMS_IOU=0.40
VISION_KEYPOINT_SCORE_THRESHOLD=0.30
VISION_MASK_BINARY_THRESHOLD=0.50

# ONNX Runtime intra-op threads per worker. Left to ORT this is one thread per
# core per session, which oversubscribes badly across several workers. Blank
# defaults to 1.
VISION_ORT_THREADS=

# ── Job execution ────────────────────────────────────────────────────────────
# Worker processes for vision analysis. Each holds ~700 MB (model weights plus
# activations) and its own ONNX Runtime session. Defaults to 1 — deliberately,
# not sized off cores or memory. This runs on a laptop alongside a browser, an
# IDE and everything else already open, not a dedicated server, and more than
# one of these loading models at the same moment is what turns "generation is
# slow" into "the whole machine stops responding to anything." Raise this only
# on a machine you have confirmed has real headroom to spare.
JOB_VISION_CONCURRENCY=
# Worker processes for creative rendering. Lighter than a vision worker (no
# ONNX session, just a canvas and a decoded image), but defaults to 1 for the
# same reason.
JOB_RENDER_CONCURRENCY=
# Poll interval (ms) for the SQLite-backed queue.
JOB_POLL_INTERVAL_MS=250
# Attempts per job before it is parked as `failed` and awaits manual retry.
JOB_MAX_ATTEMPTS=3

# ── Rendering ────────────────────────────────────────────────────────────────
# Longest edge of a generated creative.
RENDER_OUTPUT_MAX_DIM=2048
# Supersample factor before downscale (1 = off, 2 = recommended).
RENDER_SUPERSAMPLE=2
RENDER_JPEG_QUALITY=95

# ── AI Extend (self-hosted inpainting) ──────────────────────────────────────
# Only reached when a template's background mode is set to "AI Extend" — see
# services/inpaint-service and docs/DEPLOY.md. The one genuine network
# dependency in this app; everything else is local.
INPAINT_SERVICE_URL=http://localhost:8001
# 'cuda' (GPU) or 'cpu' (manual quality testing only — see docs/DEPLOY.md
# before ever setting this in a deployed environment). Read by BOTH this app
# and the inpaint-service itself; keep them in sync — this side uses it to
# size timeouts and cap its own concurrency, and it cannot see what device the
# service actually loaded.
INPAINT_DEVICE=cuda
# NOTE: the model, pipeline and working resolution are configured on the
# SERVICE, not here — see services/inpaint-service/README.md. A card with less
# than ~8 GB VRAM cannot run the default SDXL checkpoint and needs the smaller
# SD2 configuration documented there.
# Worker processes calling the inpaint service. Separate from
# JOB_RENDER_CONCURRENCY/JOB_VISION_CONCURRENCY on purpose — this workload
# waits on a remote GPU, not local CPU, so it must not be sized off cores or
# contend with them for slots. Forced to 1 whenever INPAINT_DEVICE=cpu,
# regardless of this value — see src/config.ts.
INPAINT_JOB_CONCURRENCY=2
# Request timeout (ms). Blank picks a sensible default itself: 60s for
# INPAINT_DEVICE=cuda, 600s (10 min) for =cpu — CPU inference is genuinely
# that much slower, not a value to leave at the GPU default by accident.
INPAINT_TIMEOUT_MS=
