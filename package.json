{
  "name": "vision-studio",
  "version": "0.1.0",
  "private": true,
  "description": "High-accuracy fashion product image processing. Deterministic vision engine, landmark-based framing, bulk creative generation.",
  "scripts": {
    "predev": "tsx scripts/clean-dev-cache.ts",
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/migrate.ts --reset",
    "models:fetch": "tsx scripts/fetch-models.ts",
    "models:verify": "tsx scripts/fetch-models.ts --verify-only",
    "worker": "tsx src/jobs/runner.ts",
    "setup": "npm run db:migrate && npm run models:fetch"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "better-sqlite3": "^13.0.2",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "nanoid": "^5.1.11",
    "next": "16.2.12",
    "onnxruntime-node": "^1.27.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.11"
  }
}
