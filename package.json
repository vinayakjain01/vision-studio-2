{
  "name": "vision-studio",
  "version": "0.1.0",
  "private": true,
  "description": "High-accuracy fashion product image processing. Deterministic vision engine, landmark-based framing, bulk creative generation.",
  "scripts": {
    "predev": "tsx scripts/clean-dev-cache.ts",
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "tsx scripts/check-tenancy-boundaries.ts && eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/migrate.ts --reset",
    "tenants:migrate-legacy": "tsx scripts/tenants-migrate-legacy.ts",
    "models:fetch": "tsx scripts/fetch-models.ts",
    "models:verify": "tsx scripts/fetch-models.ts --verify-only",
    "worker": "tsx src/jobs/runner.ts",
    "setup": "npm run db:migrate && npm run models:fetch",
    "bench:memory": "tsx scripts/bench-memory-client.ts",
    "admin:create-tenant": "tsx scripts/admin-create-tenant.ts",
    "admin:reset-password": "tsx scripts/admin-reset-password.ts",
    "admin:promote": "tsx scripts/admin-promote.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "tenant:export": "tsx scripts/tenant-export.ts",
    "tenant:import": "tsx scripts/tenant-import.ts",
    "loadtest": "tsx scripts/loadtest-multitenant.ts",
    "diag": "tsx scripts/diag.ts",
    "reproduce:issue4": "tsx scripts/reproduce-issue4-slow-batch.ts",
    "parse:stage-log": "tsx scripts/parse-stage-log.ts",
    "verify:issue6": "tsx scripts/verify-issue6-concurrency.ts",
    "soak:phase17": "tsx scripts/soak-test-phase17.ts",
    "debug:analyze": "tsx scripts/debug-analyze-image.ts",
    "debug:render": "tsx scripts/debug-render-image.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "archiver": "^8.0.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "12.2.0",
    "busboy": "^1.6.0",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "nanoid": "^5.1.11",
    "next": "^16.4.0",
    "onnxruntime-node": "^1.27.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.11"
  }
}
